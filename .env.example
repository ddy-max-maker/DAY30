# ============================================
# Environment Configuration Template
# ============================================
# 复制为 .env 并填入真实值。.env 不提交 Git！
#
# 寻址说明：本文件里的 host 全部使用 Docker Compose 服务名
# （mysql / redis / rabbitmq），容器之间通过 Compose 网络互访。
# 在宿主机上直跑 uvicorn/alembic 时，另建 .env.dev 填
# 127.0.0.1 + 宿主机映射端口（3307/6382），pydantic 会按
# APP_ENV 加载 .env.dev 覆盖本文件。

APP_ENV=dev

# ---------- MySQL（compose 服务名: mysql） ----------
DB_HOST=mysql
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# root 密码，compose 用它初始化 MySQL 容器
MYSQL_ROOT_PASSWORD=

# ---------- JWT Secret ----------
# Generate one: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- Redis（compose 服务名: redis） ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---------- RabbitMQ（compose 服务名: rabbitmq） ----------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# 测试环境通过 RABBITMQ_ENABLED=false 禁用真实连接
RABBITMQ_ENABLED=true

# ---------- 模拟支付网关（X-Mock-Payment-Secret） ----------
# 回调方身份校验共享密钥；留空则拒绝所有支付回调。
# 真实生产环境应替换为支付平台数字签名验签机制。
MOCK_PAYMENT_SECRET=
